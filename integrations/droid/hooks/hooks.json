{
  "SessionStart": [
    {
      "matcher": "startup|resume|clear",
      "hooks": [{ "type": "command", "command": "node \"${DROID_PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 5 }]
    }
  ],
  "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${DROID_PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 5 }] }],
  "PreToolUse": [{ "hooks": [{ "type": "command", "command": "node \"${DROID_PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 5 }] }],
  "PostToolUse": [{ "hooks": [{ "type": "command", "command": "node \"${DROID_PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 5 }] }],
  "Notification": [
    {
      "matcher": "permission_prompt|elicitation_dialog|idle_prompt",
      "hooks": [{ "type": "command", "command": "node \"${DROID_PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 5 }]
    }
  ],
  "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${DROID_PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 5 }] }],
  "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${DROID_PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 5 }] }]
}
