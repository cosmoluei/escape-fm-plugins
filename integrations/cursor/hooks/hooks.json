{
  "hooks": {
    "sessionStart": [{ "command": "node ./scripts/hook.mjs sessionStart", "timeout": 5 }],
    "beforeSubmitPrompt": [{ "command": "node ./scripts/hook.mjs beforeSubmitPrompt", "timeout": 5 }],
    "preToolUse": [{ "command": "node ./scripts/hook.mjs preToolUse", "timeout": 5 }],
    "postToolUse": [{ "command": "node ./scripts/hook.mjs postToolUse", "timeout": 5 }],
